# Copy this file to .env.local and fill in your values from the Supabase dashboard.
# Settings → API → Project URL and anon key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Resend — for booking confirmation emails (https://resend.com)
RESEND_API_KEY=re_your_key_here

# Public URL of the logo for email headers (upload to Supabase Storage or any public CDN)
# e.g. https://xxx.supabase.co/storage/v1/object/public/assets/logo.png
LOGO_PUBLIC_URL=

# Optional: used for absolute redirects in the logout API route.
# Set to your production domain in deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public-facing URL used in email links (cancel button, etc.)
# Must be reachable from the internet. Set to your Vercel URL after deploying.
# For local testing, use an ngrok tunnel: https://ngrok.com
APP_PUBLIC_URL=https://your-app.vercel.app
